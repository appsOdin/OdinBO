# ─── OdinBO – Variables de entorno ───────────────────────────
# Copiar a .env y ajustar valores para cada entorno

# Puerto expuesto en el host
APP_PORT=8080

# Aplicación
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Costa_Rica

# URL del API backend
# En Docker usa host.docker.internal para apuntar al host
# o el nombre del servicio si el API también corre en Docker (ej: http://odinapi:5104)
API_BASE_URL=http://localhost

# Tokens y sesión
TOKEN_REFRESH_MINUTES=5
SESSION_TIMEOUT=60
SESSION_NAME=odinbo_session
CSRF_TOKEN_TTL=1800

# HTTP
HTTP_TIMEOUT_SECONDS=20
